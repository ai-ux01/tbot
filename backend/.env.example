# Kotak API (for server-side calls; keep empty if frontend sends access_token)
# ACCESS_TOKEN=

# Server
PORT=4000
# Allow frontend origin (React dev server)
CORS_ORIGIN=http://localhost:5173
# Logging: LOG_LEVEL=debug|info|warn|error (default: info), LOG_FORMAT=pretty for readable lines
# LOG_LEVEL=info
# LOG_FORMAT=pretty

# MongoDB (optional for most features; required for NSE historical sync and swing backtest)
# MONGODB_URI=mongodb://localhost:27017/bot-ai

# Zerodha Kite Connect (required for /api/kite/login-url; get keys from kite.zerodha.com)
# KITE_API_KEY=your_api_key
# KITE_API_SECRET=your_api_secret
# KITE_REDIRECT_URI=http://localhost:4000/api/kite/callback
# FRONTEND_URL=http://localhost:5173

# AI Signals: ML pattern service optional (runs on port 8000 when used). Leave unset or set to empty/"disabled" to skip ML.
# ML_SERVICE_URL=http://localhost:8000
# ML_SERVICE_TIMEOUT_MS=10000
# ML_SERVICE_RETRIES=2

# Alerts: webhook URL for BUY/SELL alerts (optional)
# ALERT_WEBHOOK_URL=

# RSI Momentum Reset (1D only): peak ≥70 → Low1 (35–45) → rebound (55–65) → second pullback
# RSI_LENGTH=14
# RSI_PEAK_THRESHOLD=70
# RSI_PULLBACK_LOW_MIN=35
# RSI_PULLBACK_LOW_MAX=45
# RSI_REBOUND_MIN=55
# RSI_REBOUND_MAX=65
# RSI_PULLBACK2_MIN=35
# RSI_PULLBACK2_MAX=60
# RSI_MA_TOUCH_TOLERANCE=2.5
# RSI_MA_TOUCH_ABOVE_SLACK=3.5
# RSI_PRICE_TOLERANCE_PCT=0.5
# RSI_HIGH_CONF_TOLERANCE_PCT=0.25

# Paper trading: in-memory cash/positions reset on restart or Reset; closed trades persist to MongoDB `papertrades`
# PAPER_TRADING_CAPITAL=1000000
#
# Daily automation (default 11:59 AM Asia/Kolkata — set via PAPER_TRADING_CRON / PAPER_TRADING_CRON_TZ):
# PAPER_TRADING_CRON=59 11 * * *
# PAPER_TRADING_CRON_TZ=Asia/Kolkata
# 1) Bar exits for every open position (SL / partial TP / RSI remainder / max hold). Default on; disable: PAPER_TRADING_DAILY_BAR_EXITS=0
# PAPER_TRADING_DAILY_BAR_EXITS=1
# 2a) Cron / manual daily pipeline (no POST body): scan stored daily candles for RSI↓MA Setup (copy) live daily BUY — same as UI live list (default on)
# PAPER_TRADING_RSI_MA_COPY_LIVE=1
# PAPER_TRADING_ORDER_VALUE_INR=10000
# Optional: align paper rules with UI (profit % can be 10 or 0.10)
# PAPER_TRADING_RSI_MA_COPY_PROFIT_TARGET_PCT=10
# PAPER_TRADING_RSI_MA_COPY_RSI_REMAINDER_EXIT=70
# Fraction at first TP: 0.8 or 80 (default); 1 or 100 = exit entire position at partial TP (no remainder RSI leg)
# PAPER_TRADING_RSI_MA_COPY_PARTIAL_TP_FRACTION=0.8
# PAPER_TRADING_RSI_MA_COPY_MAX_HOLDING_DAYS=10
# PAPER_TRADING_RSI_MA_COPY_SCAN_LIMIT=5000
# 2b) Optional extra auto rows (merged; same setupId+symbol overrides scan defaults for that symbol)
# PAPER_TRADING_AUTO_ENABLED=1
# JSON array — setupId: rsi-ma-setup-copy | eighty-percent | rsi-setup | ema-crossover
# PAPER_TRADING_AUTO=[{"setupId":"rsi-ma-setup-copy","symbol":"INFY","orderValueInr":10000,"series":"day"}]
