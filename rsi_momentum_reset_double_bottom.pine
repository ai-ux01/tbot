//@version=6
indicator("RSI Momentum Reset Double Bottom (Daily)", shorttitle="RSI MR DB", overlay=false, max_labels_count=500)

// ===== Inputs =====
rsiLen = input.int(14, "RSI Length", minval=2)
rsiMaLen = input.int(14, "RSI MA Length", minval=2)
firstBottomLevel = input.float(35.0, "First Bottom Threshold", step=0.1)
reboundMin = input.float(45.0, "Rebound Min", step=0.1)
reboundMax = input.float(60.0, "Rebound Max", step=0.1)
secondBottomTolerance = input.float(5.0, "Second Bottom Tolerance", step=0.1, minval=0.1)
maxBarsBetweenPhases = input.int(30, "Max Bars Between Phases", minval=5)

// ===== Daily-only guard =====
isDaily = timeframe.isdaily
if not isDaily
    runtime.error("This indicator only works on Daily timeframe.")

// ===== Core calculations =====
rsi = ta.rsi(close, rsiLen)
rsiMa = ta.sma(rsi, rsiMaLen)

// ===== State machine (non-repainting: only confirmed historical bars) =====
var int state = 0
// 0 = waiting first bottom
// 1 = waiting rebound into 45..60
// 2 = waiting second pullback near first bottom that touches/crosses RSI MA
// 3 = waiting RSI up-turn confirmation

var float firstBottomRsi = na
var int firstBottomBar = na
var float secondBottomRsi = na
var int secondBottomBar = na

var bool buySignal = false
buySignal := false

if barstate.isconfirmed
    // Expire stale setups
    if state != 0 and not na(firstBottomBar) and (bar_index - firstBottomBar > maxBarsBetweenPhases)
        state := 0
        firstBottomRsi := na
        firstBottomBar := na
        secondBottomRsi := na
        secondBottomBar := na

    if state == 0
        if rsi < firstBottomLevel
            firstBottomRsi := rsi
            firstBottomBar := bar_index
            state := 1

    else if state == 1
        // Refresh first-bottom reference if RSI makes a deeper low before rebound
        if rsi < firstBottomLevel and rsi < firstBottomRsi
            firstBottomRsi := rsi
            firstBottomBar := bar_index
        // Rebound zone reached
        if rsi >= reboundMin and rsi <= reboundMax
            state := 2

    else if state == 2
        nearFirstBottom = math.abs(rsi - firstBottomRsi) <= secondBottomTolerance
        touchedRsiMa = rsi <= rsiMa
        if nearFirstBottom and touchedRsiMa
            secondBottomRsi := rsi
            secondBottomBar := bar_index
            state := 3
        // If setup breaks with an extended new low, restart with this as fresh first bottom
        else if rsi < (firstBottomRsi - secondBottomTolerance)
            firstBottomRsi := rsi
            firstBottomBar := bar_index
            state := 1

    else if state == 3
        // Confirm turn-up after second pullback
        if rsi > rsi[1]
            buySignal := true
            state := 0
            firstBottomRsi := na
            firstBottomBar := na
            secondBottomRsi := na
            secondBottomBar := na
        // If RSI continues falling after second bottom candidate, invalidate and restart search
        else if rsi < secondBottomRsi
            state := 0
            firstBottomRsi := na
            firstBottomBar := na
            secondBottomRsi := na
            secondBottomBar := na

// ===== Confidence grading =====
diff = (na(firstBottomRsi) or na(secondBottomRsi)) ? na : math.abs(secondBottomRsi - firstBottomRsi)
confidence =
     na(diff) ? "LOW" :
     diff < 3.0 ? "HIGH" :
     diff <= secondBottomTolerance ? "MEDIUM" : "LOW"

// Capture confidence on signal bar using stable value from previous phase
signalDiff = buySignal ? math.abs(rsi[1] - firstBottomRsi[1]) : na
signalConfidence =
     na(signalDiff) ? "LOW" :
     signalDiff < 3.0 ? "HIGH" :
     signalDiff <= secondBottomTolerance ? "MEDIUM" : "LOW"

// ===== Visuals =====
h35 = hline(firstBottomLevel, "RSI 35", color=color.new(color.red, 30))
h45 = hline(reboundMin, "Rebound Min", color=color.new(color.yellow, 60))
h60 = hline(reboundMax, "Rebound Max", color=color.new(color.yellow, 60))
h70 = hline(70, "RSI 70", color=color.new(color.gray, 80))
h30 = hline(30, "RSI 30", color=color.new(color.gray, 80))
fill(h45, h60, color=color.new(color.teal, 85), title="Rebound Zone")

plot(rsi, "RSI", color=color.new(color.blue, 0), linewidth=2)
plot(rsiMa, "RSI MA", color=color.new(color.orange, 0), linewidth=2)

// Highlight bullish setup phases visually in oscillator pane
bgcolor(state == 2 or state == 3 ? color.new(color.green, 88) : na, title="Bullish Setup Zone")

// BUY marker and confidence label in RSI pane
plotshape(buySignal ? rsi : na, title="BUY", style=shape.labelup, text="BUY", color=color.new(color.lime, 0), textcolor=color.black, location=location.absolute, size=size.small)
if buySignal
    label.new(bar_index, rsi, "CONF: " + signalConfidence, style=label.style_label_up, color=color.new(color.lime, 0), textcolor=color.black, size=size.tiny)

// Optional chart marker (below candle) using overlay-like cue in data window/alerts
alertcondition(buySignal, title="RSI Momentum Reset Double Bottom BUY", message="BUY signal on {{ticker}} (Daily) | Confidence: {{plot(\"RSI\")}}")
